# --- Hipcall API & OAuth Configuration (Example) ---
# Region: global (use.hipcall.com) or tr (use.hipcall.com.tr)
VITE_HIPCALL_REGION=global
VITE_HIPCALL_AUTHORIZE_URL=https://use.hipcall.com/oauth/authorize
VITE_HIPCALL_TOKEN_URL=https://use.hipcall.com/oauth/token
VITE_HIPCALL_API_BASE_URL=https://use.hipcall.com/api/v3
VITE_HIPCALL_SIP_CREDENTIALS_PATH=/sip/token
VITE_HIPCALL_WS_URL=wss://mgw.hipcall.com:8443
VITE_HIPCALL_CLIENT_ID=your_hipcall_oauth_client_id
VITE_HIPCALL_REDIRECT_URI=http://localhost:5173/callback
VITE_HIPCALL_SCOPE=profile email offline_access contacts:read
VITE_HIPCALL_STATE=hipcall_auth_state

# Optional custom host for local tunnel testing (e.g. ngrok)
NGROK_HOST=localhost

# --- DEVELOPMENT / SERVER PROXY ONLY (Never exposed to the browser when PKCE is enabled) ---
HIPCALL_CLIENT_SECRET=your_hipcall_oauth_client_secret
