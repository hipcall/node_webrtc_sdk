# --- Hipcall API & OAuth Yapılandırması (Örnek) ---
VITE_HIPCALL_AUTHORIZE_URL=https://use.hipcall.com.tr/oauth/authorize
VITE_HIPCALL_TOKEN_URL=https://use.hipcall.com.tr/oauth/token
VITE_HIPCALL_API_BASE_URL=https://use.hipcall.com.tr/api/v3
VITE_HIPCALL_SIP_CREDENTIALS_PATH=/sip/token
VITE_HIPCALL_WS_URL=wss://sip.hipcall.com.tr:8443
VITE_HIPCALL_CLIENT_ID=your_hipcall_oauth_client_id
VITE_HIPCALL_REDIRECT_URI=http://localhost:5173/callback
VITE_HIPCALL_SCOPE=profile email offline_access contacts:read
VITE_HIPCALL_STATE=hipcall_auth_state

# Ngrok veya özel host kullanılıyorsa (opsiyonel)
NGROK_HOST=localhost

# --- SADECE GELİŞTİRME/SUNUCU PROXY İÇİN (PKCE kullanılmadığı durumlar için, asla tarayıcıya gitmez) ---
HIPCALL_CLIENT_SECRET=your_hipcall_oauth_client_secret
